{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ppray/os-taxonomy/schema/cn-curriculum.schema.json",
  "title": "中国课标细粒度条目（如 data/cn-math-2022.json）",
  "type": "object",
  "required": ["slug", "country", "name", "version", "textIncluded", "topicCount", "topics"],
  "properties": {
    "slug": { "type": "string", "pattern": "^cn-[a-z]+-[0-9]{4}$" },
    "country": { "type": "string", "enum": ["CN"] },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "publisher": { "type": "string" },
    "sourceUrl": { "type": "string" },
    "textIncluded": { "type": "boolean", "enum": [false] },
    "note": { "type": "string" },
    "license": { "type": "string" },
    "pageOffset": { "type": "integer" },
    "stages": { "type": "object" },
    "themePages": { "type": "object" },
    "topicCount": { "type": "integer", "minimum": 0 },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "code", "data", "ageLo", "ageHi"],
        "properties": {
          "key": { "type": "string", "pattern": "^cn-[a-z]+-[0-9]{4}:(HX\\.[A-Z]{2}|S[1-4]\\.[A-Z]{2}\\.[A-Z]{2}\\.[0-9]{2})$" },
          "code": { "type": "string" },
          "data": {
            "type": "object",
            "required": ["title", "summary", "stage", "grades", "domain", "kind", "page"],
            "properties": {
              "title": { "type": "string" },
              "summary": { "type": "string" },
              "stage": { "type": "string" },
              "grades": { "type": "string" },
              "domain": { "type": "string" },
              "theme": { "type": ["string", "null"] },
              "kind": { "type": "string", "enum": ["内容要求", "主题活动", "项目学习", "核心素养"] },
              "page": { "type": "integer", "minimum": 1 },
              "examples": { "type": "array", "items": { "type": "string", "pattern": "^例[0-9]+$" } },
              "generic": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "ageLo": { "type": "integer" },
          "ageHi": { "type": "integer" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
