{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ppray/os-taxonomy/schema/cn-alignment.schema.json",
  "title": "微主题 → 中国课标 对齐记录（data/alignments/*.json）",
  "type": "object",
  "required": ["curriculum", "subject", "alignmentCount", "alignments"],
  "properties": {
    "curriculum": { "type": "string", "pattern": "^cn-[a-z]+-[0-9]{4}$" },
    "subject": { "type": "string" },
    "note": { "type": "string" },
    "method": { "type": "string" },
    "alignmentCount": { "type": "integer", "minimum": 0 },
    "alignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topicId", "status", "standards", "relation", "cnStage", "confidence", "rationale", "review"],
        "properties": {
          "topicId": { "type": "string", "pattern": "^(mt|cn)_" },
          "topicName": { "type": "string" },
          "status": { "type": "string", "enum": ["aligned", "beyond-primary", "cn-out-of-scope"] },
          "standards": { "type": "array", "items": { "type": "string" } },
          "relation": { "type": ["string", "null"], "enum": ["exact", "partial", null] },
          "cnStage": { "type": ["string", "null"], "enum": ["S1", "S2", "S3", "S4", null] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "review": { "type": "string", "enum": ["llm-draft", "teacher-reviewed"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
